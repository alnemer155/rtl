# ---- Backend / Crawler ----
# SQLite (افتراضي للتطوير) أو PostgreSQL:
# DATABASE_URL=postgresql+psycopg://masadir:masadir@localhost:5432/masadir
DATABASE_URL=sqlite:///./data/masadir.db

# Gemini — يُستخدم من الخادم فقط ولا يُرسل للمتصفح أبداً
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# الزحف — معدل محافظ افتراضياً (طلب واحد كل ثانيتين)
CRAWL_MIN_INTERVAL=2.0
CRAWL_CONCURRENCY=2
CRAWL_MAX_ATTEMPTS=4
CRAWL_USER_AGENT=MasadirScholarlyBot/0.1 (+https://github.com/masadir; respectful academic archive crawler)

# إعدادات API
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_RATE_LIMIT_PER_MINUTE=30
API_MAX_QUESTION_CHARS=2000

# ---- Frontend (frontend/.env.local) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
